classDiagram
    direction LR

    class ICardQueryRepository {
        <<interface>>
        +search_cards(filters) list~CardSummaryDTO~
        +card_count() int
    }

    class ICardDetailRepository {
        <<interface>>
        +get_card_detail(card_id) CardDetailDTO
    }

    class ILookupRepository {
        <<interface>>
        +get_lookup_options() LookupOptionsDTO
        +get_summary() AppSummaryDTO
    }

    class IDeckCommandRepository {
        <<interface>>
        +save_deck(name, memo, ban_format, items) int
        +delete_deck(deck_id) None
    }

    class IDeckQueryRepository {
        <<interface>>
        +list_decks() list~SavedDeckSummaryDTO~
        +get_deck_detail(deck_id) SavedDeckDetailDTO
        +deck_count() int
    }

    class IDeckValidationRepository {
        <<interface>>
        +get_validation_card_map(card_ids) dict
        +get_ban_status_map(card_ids, ban_format) dict
        +get_legal_candidates(extra_deck, ban_format, limit) list~dict~
    }

    class ISeedSchemaRepository {
        <<interface>>
        +apply_schema()
        +replace_catalog()
    }

    class ISeedBulkInsertRepository {
        <<interface>>
        +seed_cards(cards, source)
    }

    class ISeedMetaRepository {
        <<interface>>
        +get_meta_value(key) string
        +set_meta_value(key, value)
    }

    class ICardDataProvider {
        <<interface>>
        +fetch_cards() list~SeedCardDTO~
    }

    class DuckDbCardQueryRepository
    class DuckDbCardDetailRepository
    class DuckDbLookupRepository
    class DuckDbDeckCommandRepository
    class DuckDbDeckQueryRepository
    class DuckDbDeckValidationRepository
    class DuckDbSeedSchemaRepository
    class DuckDbSeedBulkInsertRepository
    class DuckDbSeedMetaRepository
    class YgoProDeckProvider

    class DefaultCardSearchService
    class DefaultCardDetailService
    class DefaultLookupService
    class DefaultDeckValidationService
    class DefaultSavedDeckService
    class DefaultInitializeService

    DuckDbCardQueryRepository ..|> ICardQueryRepository
    DuckDbCardDetailRepository ..|> ICardDetailRepository
    DuckDbLookupRepository ..|> ILookupRepository
    DuckDbDeckCommandRepository ..|> IDeckCommandRepository
    DuckDbDeckQueryRepository ..|> IDeckQueryRepository
    DuckDbDeckValidationRepository ..|> IDeckValidationRepository
    DuckDbSeedSchemaRepository ..|> ISeedSchemaRepository
    DuckDbSeedBulkInsertRepository ..|> ISeedBulkInsertRepository
    DuckDbSeedMetaRepository ..|> ISeedMetaRepository
    YgoProDeckProvider ..|> ICardDataProvider

    DefaultCardSearchService --> ICardQueryRepository
    DefaultCardDetailService --> ICardDetailRepository
    DefaultLookupService --> ILookupRepository
    DefaultDeckValidationService --> IDeckValidationRepository
    DefaultSavedDeckService --> IDeckCommandRepository
    DefaultSavedDeckService --> IDeckQueryRepository
    DefaultSavedDeckService --> DefaultDeckValidationService
    DefaultInitializeService --> ISeedSchemaRepository
    DefaultInitializeService --> ISeedBulkInsertRepository
    DefaultInitializeService --> ISeedMetaRepository
    DefaultInitializeService --> ICardDataProvider
