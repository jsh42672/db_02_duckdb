    CARD_TYPE {
        string name PK
    }

    ATTRIBUTE {
        string name PK
    }

    RACE {
        string name PK
    }

    ARCHETYPE {
        string name PK
    }

    CARD_SET {
        string name PK
    }

    RARITY {
        string name PK
        string code
    }

    BAN_FORMAT {
        string name PK
    }

    BAN_STATUS_TYPE {
        string name PK
    }

    DECK_SECTION {
        string name PK
    }

    PRICE_SOURCE {
        string name PK
    }

    CARD {
        bigint id PK
        string name UK
        string card_type FK
        string frame_type
        string attribute FK
        string race FK
        tinyint level
        smallint atk
        smallint def
        text description
        boolean is_extra_deck
    }

    CARD_ARCHETYPE {
        bigint card_id PK,FK
        string archetype_name PK,FK
    }

    CARD_SET_ENTRY {
        bigint id PK
        bigint card_id FK
        string set_name FK
        string set_code
        string rarity FK
        decimal set_price
    }

    BAN_STATUS {
        bigint card_id PK,FK
        string format PK,FK
        string status FK
    }

    CARD_PRICE {
        bigint card_id PK,FK
        string source_name PK,FK
        decimal price
    }

    CARD_IMAGE {
        bigint image_id PK
        bigint card_id FK
        text image_url
        text image_small
        text image_cropped
    }

    DECK {
        bigint id PK
        string name
        text memo
        string ban_format FK
        timestamp created_at
    }

    DECK_CARD {
        bigint deck_id PK,FK
        bigint card_id PK,FK
        string section PK,FK
        tinyint quantity
    }
